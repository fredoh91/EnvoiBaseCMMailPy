# ============================================================
# Modèle de configuration EnvoiBaseCMMail
# Copiez ce fichier en '.env' puis renseignez les valeurs.
# Aucune valeur ne doit comporter de guillemets.
# ============================================================

# Emplacement de l'archive 7Zip à envoyer (chemin du Dossier, terminé par un backslash)
RepFicAenvoyer=D:\Users\frannou\Dev\Access\CM\CM_Import_TT\fichiers_a_envoyer\

# Date du fichier .7z à envoyer :
#   today      => identifie le fichier CM_AAAAMMJJ_*.7z à la date du jour
#   20260925   => identifie le fichier CM_20260925_*.7z (date exacte AAAAMMJJ)
DateFicAenvoyer=today

# Emplacement complet de la base Access contenant la table TbUsers (destinataires)
BaseUsers=G:\DM-SURVEIL\MEDICAMENTS\BASES\BASES_DIVERSES\Users\Users.accdb

# Emplacement complet du fichier de log (commun avec le traitement Access)
FicLog=G:\DM-SURVEIL\MEDICAMENTS\BASES\BASE_CM\Import_TT\TT_Import.log

# ---- MODE TEST (optionnel) ----------------------------------------------
# Décommentez la ligne ci-dessous pour un TEST SANS ENVOI RÉEL du mail :
# le script valide (.env, .7z, destinataires, HTML) et affiche les infos
# sans exécuter les commandes GroupWise.
# Valeurs acceptées : 1, true, oui, o, yes, y, dryrun, test
# ModeTest=1
